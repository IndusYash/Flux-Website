# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
# This is the most important one! The node_modules folder can be huge
# and contains thousands of files that can be re-installed by anyone
# using 'npm install'.
/node_modules

# Build output
# These folders are generated when you build your project for production.
# They should not be tracked in version control.
/dist
/build

# Log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment variables
# This file often contains secret keys and API credentials.
# It should NEVER be committed to a public repository.
.env
.env.local
.env.*.local

# IDE and editor directories
# These are configuration folders for specific code editors.
.vscode/
.idea/ 
